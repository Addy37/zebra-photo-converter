{
  "name": "addy-buy-zebra-tool",
  "version": "2.0.1-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/structure.test.mjs tests/core.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:core && npm test",
    "build": "npm run check:core && vite build && node scripts/verify-build.mjs",
    "generate:core": "node scripts/core-runtime.mjs --write",
    "check:core": "node scripts/core-runtime.mjs",
    "benchmark": "node scripts/benchmark-search.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
